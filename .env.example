# Database
VIGIL_DB_URL=sqlite:///./vigil.db

# Telegram API — https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Official collectors (GDACS, Meteoalarm, DPC) do not require API credentials.

# Origini consentite per CORS (separate da virgola)
# In produzione: https://tuodominio.com
VIGIL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

